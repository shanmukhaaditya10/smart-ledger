# Postgres connection.
#
# Local docker Postgres (docker-compose): use localhost; inside the app container
# it's host "postgres".
DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger?schema=public"

# Hosted (Neon / any Postgres) — used by the Vercel deployment. Example shape:
# DATABASE_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"
