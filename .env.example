# Postgres connection (matches docker-compose). For local dev against the
# compose Postgres use localhost; inside the app container it's host "postgres".
DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger?schema=public"

# --- Optional: monthly summary email (stretch, spec §8) ---
# The app runs fine with these unset — email is skipped and only the in-app
# MONTH_SUMMARY notification is created. Provide EITHER an SMTP_URL…
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# …or discrete SMTP_* settings:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user"
# SMTP_PASS="pass"
# SMTP_FROM="Smart Ledger <ledger@example.com>"
